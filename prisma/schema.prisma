// SamaPay — the schema. SPEC: docs/scratch/samapay-api-v1-draft-2026-09-04.md
// in the SamaPrime repo (v1.1) and value-model's allowance spec.
//
// THE ONE RULE, IN TABLES: only `deposits` can raise an allowance, only
// the observer writes `deposits`, and manual deposits DO NOT EXIST HERE —
// not a table, not a column, not a source label. Absence, not a guard.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ONE CLIENT PER MERCHANT — decision #80 (Ibrahim, 2026-09-23) and the S2
// slice-1 spec: every merchant has its own pre-provisioned SamaPay account
// (a Client) with its own live key, webhook URL and webhook secret; the
// merchant's received crypto is that account's gateway balance. This
// SUPERSEDES the 2026-09-04 wording that stood here ("SamaPrime is ONE client
// of SamaPay with ONE key; it distributes internally to its merchants by
// reference — a merchant never knows SamaPay exists"). `merchant` returns as a
// value for that reason. Merchant identity is the KEY, never a request body.
enum ClientKind {
  platform // legacy: the single SamaPrime client of the 2026-09-04 model
  partner // an external site (dahabi, others) that registers on SamaPay's own site
  merchant // one pre-provisioned account per MNTAD merchant (#80)
}

enum KeyEnvironment {
  live
  test
}

enum Chain {
  BEP20
  TRC20
}

enum DepositStatus {
  detected
  confirmed
  orphaned
}

// value-model's vocabulary, adopted verbatim. CONSUMING SET = everything
// except cancelled, expired, refunded, rejected. Restores are STATUS
// TRANSITIONS, never timer properties; `failed` and `send_unknown` keep
// consuming until an explicit `refunded` backed by on-chain-absence evidence.
enum WithdrawalStatus {
  pending
  sending
  sent
  confirmed
  cancelled
  expired
  send_unknown
  failed
  refunded
  rejected
}

enum ReservationStatus {
  held
  released
  expired
}

model Client {
  id        String     @id @default(cuid())
  name      String
  kind      ClientKind
  // NO LINK TO A SAMAPRIME ACCOUNT, DELIBERATELY. A `samaprime_merchant_id`
  // column lived here until 2026-09-04 and was removed with the model
  // correction: the two systems are separate, and nothing about a
  // SamaPrime merchant belongs in this table.
  createdAt DateTime   @default(now()) @map("created_at")

  // ── PHASE 0 ACCOUNT TERMS (contract §0, §2, §5; set by scripts/issue-key.ts) ──
  // The merchant's fee in basis points (0..10000, SamaPrime 0). Deducted from
  // the merchant's GATEWAY balance, never from a customer's store credit. It
  // is STAMPED onto each deposit at confirmation (deposits.fee_amount) so a
  // later change never rewrites history; this column is the rate for the next
  // confirmation only. Range is enforced by the CLI's Zod schema, not a CHECK
  // (a CHECK is invisible to schema.prisma and would read as drift).
  feeBps        Int     @default(0) @map("fee_bps")
  // Inclusive bounds on a payment intent's `amount`; outside → 422 amount_out_of_range.
  minIntent     Decimal @default(1) @map("min_intent") @db.Decimal(18, 6)
  maxIntent     Decimal @default(10000) @map("max_intent") @db.Decimal(18, 6)
  // Chains this client may create intents / addresses on; outside → 422 unsupported_chain.
  enabledChains Chain[] @default([BEP20, TRC20]) @map("enabled_chains")

  keys       ClientKey[]
  intents    PaymentIntent[]
  events     Event[]
  addresses  Address[]
  deposits   Deposit[]
  deliveries WebhookDelivery[]

  @@map("clients")
}

// A key is the unit of everything: addresses are issued to a key, deposits
// land at a key, the allowance is per key, the idempotency scope is per key.
//
// ⚠️ THE PER-KEY LOCK IS `pg_advisory_xact_lock(hashtext(id))`, TAKEN AS
// THE FIRST STATEMENT OF allowance.reserve(). NOT `SELECT … FOR UPDATE` ON
// THIS ROW: auth middleware writes `last_used_at` on every request for the
// key, so a row lock would serialise every withdrawal against every API
// call the same client makes. Do not "simplify" it.
model ClientKey {
  id             String         @id @default(cuid())
  clientId       String         @map("client_id")
  client         Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  name           String
  keyPrefix      String         @unique @map("key_prefix") // first 12 chars of the plaintext key — the lookup
  keyHash        String         @map("key_hash") // argon2 of the FULL plaintext key; the key is never stored
  keyLast4       String         @map("key_last4")
  scopes         String[] // addresses.write deposits.read withdrawals.write withdrawals.read balance.read keys.issue
  environment    KeyEnvironment @default(live)
  rpsLimit       Int            @default(10) @map("rps_limit")
  monthlyLimit   Int            @default(100000) @map("monthly_limit")
  active         Boolean        @default(true)
  lastUsedAt     DateTime?      @map("last_used_at")
  lastUsedIp     String?        @map("last_used_ip")
  // Keys come only from Ibrahim's hand or a SamaPrime admin action. Recorded
  // on the row so the audit of "who can move money" is one query.
  issuedBy       String         @map("issued_by") // 'ibrahim' | 'samaprime_admin:<userId>'
  issuedVia      String         @map("issued_via") // 'cli' | 'samaprime_admin_action'
  // v2 rotation: the key that inherits this key's addresses and allowance.
  // Column in v1 so rotation is a data change, not a schema change.
  successorKeyId String?        @map("successor_key_id")
  revokedAt      DateTime?      @map("revoked_at")
  revokedReason  String?        @map("revoked_reason")
  // Per-client-key webhook target and secret. `webhook_secret` holds AEAD
  // CIPHERTEXT ONLY (src/keys/webhook-secret.ts, "v1:" prefix) — never the
  // plaintext, which is printed once by the CLI. The dispatcher DECRYPTS it
  // and refuses to sign with anything that does not decrypt.
  webhookUrl     String?        @map("webhook_url")
  webhookSecret  String?        @map("webhook_secret")
  createdAt      DateTime       @default(now()) @map("created_at")

  addresses    Address[]
  deposits     Deposit[]
  withdrawals  Withdrawal[]
  reservations Reservation[]
  idempotency  IdempotencyKey[]
  deliveries   WebhookDelivery[]
  audit        AuditEvent[]
  intents      PaymentIntent[]
  events       Event[]

  @@index([clientId, active])
  @@map("client_keys")
}

// Attribution is created HERE, at derivation time: an address belongs to
// one key and one reference for life. That is what makes "how much came
// in for this key" answerable — the question SamaPrime could not answer.
model Address {
  id              String    @id @default(cuid())
  keyId           String    @map("key_id")
  key             ClientKey @relation(fields: [keyId], references: [id], onDelete: Restrict)
  // OWNERSHIP BY CLIENT (contract v1.1 A6/A11.5): reads authorize by
  // client_id, so an address stays reachable after its key is rotated.
  // NULLABLE ON PURPOSE — EXPAND→DEPLOY→CONTRACT (A12): the Phase 0
  // migration adds + backfills it; NOT NULL comes in a separate migration
  // applied only after the code that always writes it is deployed
  // (prisma/contract-pending/). Every new insert MUST set it.
  clientId        String?   @map("client_id")
  client          Client?   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  reference       String // the client's opaque string (its customer id, order id)
  chain           Chain
  address         String
  derivationIndex Int       @map("derivation_index")
  // 192 legacy SamaPrime addresses are imported under the platform key at
  // cutover with allowance = none; this marks them so nothing ever counts
  // their history as an allowance by accident.
  legacyImport    Boolean   @default(false) @map("legacy_import")
  // Contract §9 step 0: set by scripts/ops/disable-address.ts. A non-null
  // value means the observer does NOT watch this address. The row is never
  // deleted (its derivation index stays taken, its history stays readable).
  // TIMESTAMP(3) like every other timestamp in this database, NOT timestamptz:
  // one column of a different type is how a with/without-time-zone comparison
  // invents a two-hour gap. Prisma writes UTC into all of them.
  watchDisabledAt DateTime? @map("watch_disabled_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  deposits Deposit[]
  intent   PaymentIntent?

  @@unique([chain, address])
  @@unique([chain, derivationIndex])
  // A7: one address per (client, chain, reference) — POST /v1/addresses is
  // idempotent by this index under concurrency, not by a findFirst.
  @@unique([clientId, chain, reference])
  @@index([keyId, reference])
  @@map("addresses")
}

// *** THE ONLY WRITER OF THIS TABLE IS src/observer/. *** Asserted by a
// verify script with a present-control, not by this comment. One credit
// per on-chain event is STRUCTURAL: UNIQUE(chain, tx_hash).
//
// ⚠️ CHANNELS (Ibrahim's architecture note + decision, 2026-09-06): this row
// becomes a PAYMENT on a channel, and two things change here, both in C2 of
// docs/panel-survey-2026-09-06.md, neither yet applied:
//  1. `channel` + `currency` columns, because "ALLOWANCE PER (CHANNEL,
//     CURRENCY) — USDT, ShamCash-SYP, ShamCash-USD are SEPARATE LEDGERS"
//     (his words). `amount` with no currency cannot be summed across them.
//  2. UNIQUE(chain, tx_hash) is chain-shaped; a Sham Cash confirmation has
//     neither. It becomes UNIQUE(channel, external_ref) (crypto's
//     external_ref IS the tx hash). That index is the guarantee; the
//     verifier's "unique id" is a promise. NEITHER GUARD IS REDUNDANT: CODE
//     REFUSES CLEANLY ON RETRY, DB REFUSES UNDER TRUE CONCURRENCY — two
//     guards with one message are one guard, so they surface DISTINCT
//     outcomes.
model Deposit {
  id            String        @id @default(cuid())
  keyId         String        @map("key_id")
  key           ClientKey     @relation(fields: [keyId], references: [id], onDelete: Restrict)
  // A11.5 / A12: the owning client, copied from the address at record time.
  // Nullable until the contract-pending NOT NULL migration; always written.
  clientId      String?       @map("client_id")
  client        Client?       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  addressId     String        @map("address_id")
  address       Address       @relation(fields: [addressId], references: [id], onDelete: Restrict)
  chain         Chain
  txHash        String        @map("tx_hash")
  amount        Decimal       @db.Decimal(18, 6)
  confirmations Int           @default(0)
  status        DepositStatus @default(detected)
  blockNumber   BigInt?       @map("block_number")
  // The merchant fee on THIS deposit, stamped by the observer in the same
  // update that flips detected → confirmed: computeFee(amount, client.fee_bps)
  // from src/allowance/fee.ts (the ONE calculator — truncated DOWN to 6 dp,
  // never more than the rate). 0 until confirmed and for every row confirmed
  // before Phase 0. Balance and allowance subtract it; an intent's
  // `fee_amount` is the sum over its confirmed deposits (not stored).
  feeAmount     Decimal       @default(0) @map("fee_amount") @db.Decimal(18, 6)
  detectedAt    DateTime      @default(now()) @map("detected_at")
  creditedAt    DateTime?     @map("credited_at") // set exactly once, on confirmed

  @@unique([chain, txHash])
  @@index([keyId, status])
  @@map("deposits")
}

// `withdrawn(key)` = SUM(amount) over rows in the CONSUMING set, AND NOTHING
// ELSE. There is no second amount anywhere (reservations carry none) — two
// calculators is the display-vs-charge divergence shape.
model Withdrawal {
  id             String           @id @default(cuid())
  keyId          String           @map("key_id")
  key            ClientKey        @relation(fields: [keyId], references: [id], onDelete: Restrict)
  reference      String?
  toAddress      String           @map("to_address")
  chain          Chain
  amount         Decimal          @db.Decimal(18, 6)
  fee            Decimal          @default(0) @db.Decimal(18, 6)
  status         WithdrawalStatus @default(pending)
  idempotencyKey String           @map("idempotency_key")
  txHash         String?          @map("tx_hash")
  // markRefunded's on-chain-absence proof lives beside the transition.
  evidence       Json?
  requestedAt    DateTime         @default(now()) @map("requested_at")
  sentAt         DateTime?        @map("sent_at")
  resolvedAt     DateTime?        @map("resolved_at")

  reservation Reservation?

  @@unique([keyId, idempotencyKey])
  @@index([keyId, status])
  @@map("withdrawals")
}

// METADATA ONLY (value-model's option b): points at the pending withdrawal,
// carries NO amount of its own, never enters any sum. release/expire flip
// the withdrawal's status and stamp this row.
model Reservation {
  id           String            @id @default(cuid())
  keyId        String            @map("key_id")
  key          ClientKey         @relation(fields: [keyId], references: [id], onDelete: Restrict)
  withdrawalId String            @unique @map("withdrawal_id")
  withdrawal   Withdrawal        @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)
  status       ReservationStatus @default(held)
  createdAt    DateTime          @default(now()) @map("created_at")
  releasedAt   DateTime?         @map("released_at")
  reason       String?

  @@index([keyId, status])
  @@map("reservations")
}

enum IdempotencyStatus {
  processing
  completed
  failed
}

// Scope is (key, Idempotency-Key) — never global. The SamaPrime engine's
// contract: fast claim row, work outside the transaction, write back.
model IdempotencyKey {
  id           String            @id @default(cuid())
  keyId        String            @map("key_id")
  key          ClientKey         @relation(fields: [keyId], references: [id], onDelete: Restrict)
  idemKey      String            @map("idem_key")
  requestHash  String            @map("request_hash") @db.Char(64)
  status       IdempotencyStatus @default(processing)
  statusCode   Int?              @map("status_code")
  responseBody Json?             @map("response_body")
  lockedAt     DateTime          @default(now()) @map("locked_at")
  expiresAt    DateTime          @map("expires_at")

  @@unique([keyId, idemKey])
  @@map("idempotency_keys")
}

enum DeliveryStatus {
  pending
  delivered
  failed
  exhausted
}

model WebhookDelivery {
  id             String         @id @default(cuid())
  keyId          String         @map("key_id")
  key            ClientKey      @relation(fields: [keyId], references: [id], onDelete: Restrict)
  // A11.5 / A12: nullable until the contract-pending migration; always written.
  clientId       String?        @map("client_id")
  client         Client?        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  eventType      String         @map("event_type") // deposit.confirmed | withdrawal.sent | withdrawal.failed
  eventId        String         @map("event_id")
  payload        Json
  attempts       Int            @default(0)
  status         DeliveryStatus @default(pending)
  nextAttemptAt  DateTime?      @map("next_attempt_at")
  lastStatusCode Int?           @map("last_status_code")
  lastError      String?        @map("last_error")
  createdAt      DateTime       @default(now()) @map("created_at")
  deliveredAt    DateTime?      @map("delivered_at")

  // G3: at most one delivery series per (key, event) — the enqueue is
  // idempotent structurally, not by a findFirst race.
  @@unique([keyId, eventId])
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

// Hash-chained, append-only (trigger in the first migration). Every state
// change: who (client key or admin or observer), what, when, on which row.
model AuditEvent {
  id             String     @id @default(cuid())
  at             DateTime   @default(now())
  keyId          String?    @map("key_id")
  key            ClientKey? @relation(fields: [keyId], references: [id], onDelete: Restrict)
  actor          String // 'client' | 'admin:<who>' | 'observer' | 'sender' | 'reconciler'
  action         String // address.issued deposit.detected deposit.confirmed withdrawal.requested ... key.issued key.revoked
  subjectId      String?    @map("subject_id")
  idempotencyKey String?    @map("idempotency_key")
  params         Json?
  prevHash       String     @map("prev_hash") @db.Char(64)
  hash           String     @unique @db.Char(64)

  @@index([keyId, at])
  @@map("audit_events")
}

/// The seed vault's home. One row, id=1, mirroring SamaPrime's CryptoConfig
/// so the window's step 4 ("seed COPIED into SamaPay's vault") is a copy of a
/// blob rather than a re-encryption.
///
/// ⚠️ THE CIPHERTEXT IN THIS TABLE IS ONLY DECRYPTABLE BY CODE THAT KEEPS TWO
/// STRINGS BYTE-IDENTICAL — the AES-GCM AAD "salamwallet-vault-v1" and the
/// HKDF info "salamwallet-vault-key-v1". They read like brand names in a repo
/// called SamaPay and they are cryptographic INPUTS with no recovery path.
/// See SamaPrime CLAUDE.md RULE 2 and scripts/verify-vault-constants.ts here.
model CryptoConfig {
  id                  Int      @id @default(1)
  encryptedMasterSeed String   @map("encrypted_master_seed")
  seedFingerprint     String   @map("seed_fingerprint")
  createdAt           DateTime @default(now()) @map("created_at")

  /// MIRRORS SamaPrime EXACTLY. My first version invented `vaultCiphertext`
  /// and omitted both hot-wallet columns, because I mirrored the model from a
  /// COMMENT-TRUNCATED read of it. The window COPIES a row between these two
  /// tables; a column that differs by name is a copy that silently drops a field.
  vaultVerifier         String? @map("vault_verifier")
  hotWalletAddressBep20 String? @map("hot_wallet_address_bep20")
  hotWalletAddressTrc20 String? @map("hot_wallet_address_trc20")

  @@map("crypto_config")
}

/// The observer's cursor. `ChainObserver.scan()` is documented as persisting
/// its own cursor, and SamaPay had nowhere to keep one — so a restart would
/// have rescanned from scratch or, worse, from head, silently skipping every
/// block in between. Mirrors SamaPrime's CryptoScanCursor, advanced under the
/// same monotonic guard (lastScannedBlock < newValue) so a late tick can never
/// move it backwards.
model ScanCursor {
  chain            Chain    @id
  lastScannedBlock BigInt   @map("last_scanned_block")
  // Contract §9 step 5b: scripts/ops/start-legacy-watch.ts sets the cursor to
  // MNTAD's final block AND this stamp in ONE transaction. NULL = the observer
  // skips `legacy_import` addresses on this chain (MNTAD's scanner still owns
  // them); non-null = SamaPay watches them from this cursor on.
  legacyWatchEnabledAt DateTime? @map("legacy_watch_enabled_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("scan_cursors")
}

/// A range the observer did NOT scan, recorded rather than inferred.
///
/// ⚠️ PORTED FROM SamaPrime's CryptoScanGap, WHICH EXISTS BECAUSE ITS CURSOR
/// WENT DARK TWICE IN TWO DAYS — 947 blocks on a TronGrid 429, 13,319 when all
/// three BSC endpoints rate-limited at once. Nothing was lost either time, and
/// that was established by RE-SCANNING rather than assumed.
///
/// The cursor already protects the MONEY: it only ever advances to what was
/// actually scanned, so a provider outage stalls it rather than skipping past.
/// This table protects the DIAGNOSIS — without it, "the deposit was missed" and
/// "the deposit never arrived" produce identical evidence.
model ScanGap {
  id        String    @id @default(cuid())
  chain     Chain
  fromBlock BigInt    @map("from_block")
  toBlock   BigInt    @map("to_block")
  reason    String
  evidence  String?
  closedAt  DateTime? @map("closed_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([chain, closedAt])
  @@map("scan_gaps")
}

// ── PAYMENT INTENTS (S2 slice 1) ────────────────────────────────────────────
// A fixed-amount request to be paid on-chain. Each intent owns ONE freshly
// derived address (never reused, index above the configured floor — see
// src/chain/derivation-floor.ts). The observer advances the status from the
// deposits at that address; `amount_received` is NOT stored — it is read from
// confirmed deposits, the one calculator (src/intents/advance.ts).
//   requires_payment → processing → succeeded | succeeded_late
//                    → expired | expired_partial → (late payment) succeeded_late
enum PaymentIntentStatus {
  requires_payment
  processing
  succeeded
  succeeded_late
  expired
  expired_partial
}

model PaymentIntent {
  id          String              @id // pi_…
  clientId    String              @map("client_id")
  client      Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  // The creating key: its webhook URL/secret receive this intent's events.
  keyId       String              @map("key_id")
  key         ClientKey           @relation(fields: [keyId], references: [id], onDelete: Restrict)
  addressId   String              @unique @map("address_id")
  address     Address             @relation(fields: [addressId], references: [id], onDelete: Restrict)
  chain       Chain
  amount      Decimal             @db.Decimal(18, 6)
  reference   String // the store's own id for this payment; opaque here
  status      PaymentIntentStatus @default(requires_payment)
  expiresAt   DateTime            @map("expires_at")
  succeededAt DateTime?           @map("succeeded_at")
  expiredAt   DateTime?           @map("expired_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  events PaymentIntentEvent[]

  // A7: one intent per (client, reference). Same reference + same
  // amount/chain → the existing intent; different → 409 reference_conflict.
  @@unique([clientId, reference])
  @@index([status, expiresAt])
  @@map("payment_intents")
}

// ⚠️ SUPERSEDED BY `Event` (events table, Phase 0 migration) BEFORE ANY ROW WAS
// WRITTEN: the contract's envelope covers deposits too and needs a snapshot.
// No code writes or reads this table; it stays only because its migration
// (20260924000000) is already in the chain. Drop it in a later CONTRACT step.
model PaymentIntentEvent {
  id        String        @id // evt_…
  intentId  String        @map("intent_id")
  intent    PaymentIntent @relation(fields: [intentId], references: [id], onDelete: Restrict)
  type      String // payment_intent.succeeded | payment_intent.expired
  createdAt DateTime      @default(now()) @map("created_at")

  @@unique([intentId, type])
  @@map("payment_intent_events")
}

// ── EVENTS (Phase 0, contract §4 + §7) ─────────────────────────────────────
// The webhook body and GET /v1/events/:id, stored once and rendered the same
// way every time:
//   { id, object:"event", api_version, type, created_at, data:{ object: snapshot } }
// ONE EVENT PER (object, type) — structural, by the unique below, so two
// concurrent observer ticks cannot both emit payment_intent.succeeded for one
// intent. The writer is src/events (enqueueEvent), inside the SAME transaction
// as the state change it announces, with the webhook delivery enqueued beside
// it (webhook_deliveries.event_id = this id). `deposit.confirmed` exists only
// for deposits to non-intent addresses (contract §4).
enum EventObjectKind {
  payment_intent
  deposit
}

model Event {
  id         String          @id // evt_…
  // Owner: GET /v1/events/:id answers 404 unless client_id is the caller's.
  clientId   String          @map("client_id")
  client     Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  // The key whose webhook URL/secret receives it (the intent's or deposit's key).
  keyId      String          @map("key_id")
  key        ClientKey       @relation(fields: [keyId], references: [id], onDelete: Restrict)
  type       String // payment_intent.succeeded | payment_intent.expired | deposit.confirmed
  objectKind EventObjectKind @map("object_kind")
  objectId   String          @map("object_id") // pi_… or the deposit id
  // Frozen at event time; an api_version change never rewrites an old event.
  apiVersion String          @default("2026-09-24") @map("api_version")
  // The PaymentIntent or Deposit exactly as the contract renders it AT EVENT
  // TIME — `data.object`. Receivers must re-fetch; this is a notification.
  snapshot   Json
  createdAt  DateTime        @default(now()) @map("created_at")

  @@unique([objectId, type])
  @@index([clientId, createdAt])
  @@map("events")
}
