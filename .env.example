# SamaPay — copy to .env. NEVER commit .env. NEVER `source` this file in a shell
# (an unquoted value with a space executes); parse the one key you need.
DATABASE_URL=postgresql://samapay:CHANGE_ME@localhost:5432/samapay
# Verify scripts refuse any database whose name does not end in _sandbox:
# DATABASE_URL=postgresql://samapay:CHANGE_ME@localhost:5432/samapay_sandbox
PORT=3090
HOST=127.0.0.1
# Chain layer — filled at step 4 (the lib/crypto move). Until then the
# observer and sender are interface stubs and refuse to run.
CRYPTO_MODE=testnet
SEED_ENCRYPTION_KEY=
LOG_LEVEL=info
